# Copy to .env and fill in. Never commit the real file.
# These are read from the process environment; nothing here belongs in the
# privacy config, and nothing from the privacy config belongs here.

# ---------------------------------------------------------------------------
# Encryption key — REQUIRED by every process
# ---------------------------------------------------------------------------
# Decrypts the message store. Generate with:  npm run cli -- keygen
# Lose it and the stored messages are unrecoverable. Leak it, together with a
# copy of the database, and everything in it is readable.
LINE_CONNECTOR_KEY=

# Alternative: read the key from a file instead of the environment, which keeps
# it out of `ps` output and shell history. Set one or the other, not both.
# LINE_CONNECTOR_KEY_FILE=/etc/line-connector/key

# ---------------------------------------------------------------------------
# LINE credentials — from the LINE Developers Console
# ---------------------------------------------------------------------------
# Channel secret, under "Basic settings". Required by the ingest server only;
# without it webhook signatures cannot be verified.
LINE_CHANNEL_SECRET=

# Channel access token, under the "Messaging API" tab.
# Only needed if you enable sending, display-name lookup, or media download.
# The MCP server does not need this for read-only use — leave it unset there,
# so the process Claude drives cannot message anyone even if something goes
# wrong.
# LINE_CHANNEL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Paths and ports
# ---------------------------------------------------------------------------
# LINE_CONNECTOR_DB=data/line.db
# LINE_CONNECTOR_CONFIG=config/privacy.json
# LINE_CONNECTOR_MEDIA_DIR=media
# LINE_CONNECTOR_PORT=8787
# LINE_CONNECTOR_WEBHOOK_PATH=/webhook

# ---------------------------------------------------------------------------
# Sending
# ---------------------------------------------------------------------------
# Sending requires BOTH this variable and `mcp.allowSend` in the privacy config.
# Two independent switches, so neither a stray config edit nor a stray env var
# alone gives the model the ability to message a real person.
# LINE_CONNECTOR_ALLOW_SEND=true
